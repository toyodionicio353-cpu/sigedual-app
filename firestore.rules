rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{docId} {
      allow read: if request.auth != null;
      // Creación: el propio usuario (alta de cuenta, incluida la firma
      // de Firebase Auth que queda momentáneamente autenticada como el
      // nuevo usuario al crearlo) o un administrador completando una
      // ficha. Sin restricción de campos: el documento no existe todavía.
      allow create: if request.auth != null
        && (request.auth.uid == docId
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador');
      // Edición: un administrador puede modificar cualquier cuenta (rol,
      // estado, especialidad, etc. — eso es Administración). El propio
      // usuario solo puede editar su perfil personal (Mi perfil) y NUNCA
      // su rol, estado de cuenta, liceo, correo, nombre o especialidad —
      // el frontend los bloquea, pero la regla es la que realmente protege.
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
        || (request.auth.uid == docId
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['rol', 'activo', 'liceoId', 'email', 'nombre', 'especialidad', 'uid']))
      );
      // Eliminación: solo vía la API de administrador (firebase-admin, con su propia
      // verificación de rol) — nunca directamente desde el cliente.
      allow delete: if false;
    }

    match /sesiones/{sesionId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /auditoria/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    match /liceos/{liceoId} {
      allow read: if true;
      // Solo el administrador, o el director de ESE liceo, puede modificarlo.
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['administrador', 'director']
        && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.liceoId == liceoId);
    }

    match /codigosAcceso/{liceoId} {
      // Lectura pública: se necesita para validar el código al crear una
      // cuenta, momento en el que la persona todavía no tiene sesión.
      allow read: if true;
      // Solo el administrador, o el director de ESE liceo, puede generar
      // o renovar el código.
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['administrador', 'director']
        && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.liceoId == liceoId);
    }

    match /solicitudesModificacion/{id} {
      // Solicitudes de cambio de un dato bloqueado del propio perfil (Mi
      // perfil > Solicitar modificación). Solo su autor o un administrador
      // pueden leerlas; solo un administrador puede resolverlas (estado).
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /soporte/{liceoId} {
      allow read: if request.auth != null;
      // Solo el administrador (dueño de la plataforma) puede editar el
      // contacto de soporte, ni siquiera el director.
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /contadores/{contadorId} {
      allow read, write: if request.auth != null;
    }

    match /tickets/{ticketId} {
      // Lectura: quien lo creó, o el administrador (nunca otros usuarios).
      allow read: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow create: if request.auth != null && request.resource.data.creadoPor == request.auth.uid;
      // Cambios de estado/prioridad/asignación: solo el administrador.
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    // Hilo público del ticket: visible/editable por su creador o el administrador.
    match /tickets/{ticketId}/mensajes/{msgId} {
      allow read, create: if request.auth != null && (
        get(/databases/$(database)/documents/tickets/$(ticketId)).data.creadoPor == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow update, delete: if false;
    }

    // Notas internas: exclusivas del administrador, el creador del ticket nunca las ve.
    match /tickets/{ticketId}/notasInternas/{notaId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /notificaciones/{notifId} {
      // Cada notificación es visible/editable solo por su destinatario
      // (marcar como leída). Cualquier usuario autenticado puede crear una
      // notificación dirigida a otro (ej: un ticket nuevo notifica al admin).
      allow read, update, delete: if request.auth != null && resource.data.destinatarioUid == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Colecciones de nivel raíz
    match /{collection}/{docId} {
      allow read, write: if request.auth != null;
    }

    // Subcolecciones de conversaciones (mensajes)
    match /conversaciones/{convId}/{subCollection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
