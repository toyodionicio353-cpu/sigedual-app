rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones auxiliares ──────────────────────────────────────────
    //
    // Firestore evalúa TODOS los bloques `match` cuya ruta coincida con la
    // petición, y concede acceso si CUALQUIERA de ellos lo permite (unión,
    // no "el más específico gana"). Por eso el catch-all al final de este
    // archivo debe excluir explícitamente toda colección que tenga su
    // propio bloque `match` más arriba — si no, el catch-all seguiría
    // otorgando lectura/escritura abierta a esa colección sin importar
    // cuán estricta sea su regla dedicada. Ver `tieneReglaPropia`.

    function datosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Administrador: alcance global. Director/Coordinador: su liceo
    // completo. Ver lib/permisos/ambito.ts (misma matriz, lado cliente).
    function esAccesoCompletoLiceo(liceoId) {
      return request.auth != null && (
        datosUsuario().rol == 'administrador'
        || ((datosUsuario().rol == 'director' || datosUsuario().rol == 'coordinador') && datosUsuario().liceoId == liceoId)
      );
    }

    // ¿Existe un documento de índice que autorice a este profesor sobre
    // este recurso? (colección `autorizaciones`, mantenida por
    // lib/permisos/sincronizarAutorizacion.ts a partir de las Asignaciones
    // reales — una regla no puede ejecutar una consulta, solo leer por
    // ruta conocida, por eso existe este índice).
    function tieneAutorizacion(tipo, recursoId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/autorizaciones/$(request.auth.uid + '_' + tipo + '_' + recursoId));
    }

    function tieneReglaPropia(coleccion) {
      return coleccion in [
        'usuarios', 'sesiones', 'auditoria', 'liceos', 'codigosAcceso',
        'solicitudesModificacion', 'soporte', 'contadores', 'tickets',
        'notificaciones', 'estudiantes', 'asignaciones', 'centros_duales',
        'maestros_guia', 'visitas', 'autorizaciones', 'conversaciones'
      ];
    }

    match /usuarios/{docId} {
      allow read: if request.auth != null;
      // Creación: el propio usuario (alta de cuenta, incluida la firma
      // de Firebase Auth que queda momentáneamente autenticada como el
      // nuevo usuario al crearlo) o un administrador completando una
      // ficha. Sin restricción de campos: el documento no existe todavía.
      allow create: if request.auth != null
        && (request.auth.uid == docId
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador');
      // Edición: un administrador puede modificar cualquier cuenta (rol,
      // estado, especialidad, etc. — eso es Administración). El propio
      // usuario solo puede editar su perfil personal (Mi perfil) y NUNCA
      // su rol, estado de cuenta, liceo, correo, nombre o especialidad —
      // el frontend los bloquea, pero la regla es la que realmente protege.
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
        || (request.auth.uid == docId
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['rol', 'activo', 'liceoId', 'email', 'nombre', 'especialidad', 'uid']))
      );
      // Eliminación: solo vía la API de administrador (firebase-admin, con su propia
      // verificación de rol) — nunca directamente desde el cliente.
      allow delete: if false;
    }

    match /sesiones/{sesionId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Registro de auditoría: cualquiera autenticado puede crear un evento
    // (denegaciones, acciones sensibles), pero solo el administrador puede
    // leerlo. Nadie puede editar ni borrar un registro ya escrito.
    match /auditoria/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && datosUsuario().rol == 'administrador';
      allow update, delete: if false;
    }

    match /liceos/{liceoId} {
      allow read: if true;
      // Solo el administrador, o el director de ESE liceo, puede modificarlo.
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['administrador', 'director']
        && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.liceoId == liceoId);
    }

    match /codigosAcceso/{liceoId} {
      // Lectura pública: se necesita para validar el código al crear una
      // cuenta, momento en el que la persona todavía no tiene sesión.
      allow read: if true;
      // Solo el administrador, o el director de ESE liceo, puede generar
      // o renovar el código.
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['administrador', 'director']
        && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.liceoId == liceoId);
    }

    match /solicitudesModificacion/{id} {
      // Solicitudes de cambio de un dato bloqueado del propio perfil (Mi
      // perfil > Solicitar modificación). Solo su autor o un administrador
      // pueden leerlas; solo un administrador puede resolverlas (estado).
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /soporte/{liceoId} {
      allow read: if request.auth != null;
      // Solo el administrador (dueño de la plataforma) puede editar el
      // contacto de soporte, ni siquiera el director.
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /contadores/{contadorId} {
      allow read, write: if request.auth != null;
    }

    match /tickets/{ticketId} {
      // Lectura: quien lo creó, o el administrador (nunca otros usuarios).
      allow read: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow create: if request.auth != null && request.resource.data.creadoPor == request.auth.uid;
      // Cambios de estado/prioridad/asignación: solo el administrador.
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    // Hilo público del ticket: visible/editable por su creador o el administrador.
    match /tickets/{ticketId}/mensajes/{msgId} {
      allow read, create: if request.auth != null && (
        get(/databases/$(database)/documents/tickets/$(ticketId)).data.creadoPor == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow update, delete: if false;
    }

    // Notas internas: exclusivas del administrador, el creador del ticket nunca las ve.
    match /tickets/{ticketId}/notasInternas/{notaId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /notificaciones/{notifId} {
      // Cada notificación es visible/editable solo por su destinatario
      // (marcar como leída). Cualquier usuario autenticado puede crear una
      // notificación dirigida a otro (ej: un ticket nuevo notifica al admin).
      allow read, update, delete: if request.auth != null && resource.data.destinatarioUid == request.auth.uid;
      allow create: if request.auth != null;
    }

    // ── Autorización granular por ámbito (Formación Profesional Dual) ──
    //
    // Pertenecer al mismo liceo/dominio ya no es suficiente por sí solo.
    // administrador → global. director/coordinador → su liceo completo.
    // profesor → solo su ámbito: los estudiantes/centros/maestros guía
    // vinculados a él por una Asignacion real (ver `autorizaciones` más
    // abajo, y lib/permisos/ en el cliente).

    match /estudiantes/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('estudiante', id))
      );
      allow create: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador', 'profesor'])
      );
      allow update: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('estudiante', id))
      );
      // Eliminar un estudiante es una acción administrativa, no de supervisión.
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    match /asignaciones/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || resource.data.profesorSupervisorId == request.auth.uid
      );
      allow create: if request.auth != null && (
        esAccesoCompletoLiceo(request.resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == request.resource.data.liceoId)
      );
      // Un profesor solo puede modificar/eliminar una asignación de la que
      // ya es responsable — no puede tocar la de un colega.
      allow update, delete: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || resource.data.profesorSupervisorId == request.auth.uid
      );
    }

    match /centros_duales/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('centro', id))
      );
      allow create: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador', 'profesor'])
      );
      allow update: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('centro', id))
      );
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    match /maestros_guia/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('maestro', id))
      );
      allow create: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador', 'profesor'])
      );
      allow update: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('maestro', id))
      );
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    match /visitas/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && (
          resource.data.profesorId == request.auth.uid
          || (('estudianteId' in resource.data) && tieneAutorizacion('estudiante', resource.data.estudianteId))
        ))
      );
      allow create: if request.auth != null && (
        esAccesoCompletoLiceo(request.resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == request.resource.data.liceoId)
      );
      allow update, delete: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || resource.data.profesorId == request.auth.uid
      );
    }

    // Índice de autorización: un documento por (profesor, tipo, recurso)
    // que respalda `tieneAutorizacion()` arriba. Se mantiene desde
    // lib/permisos/sincronizarAutorizacion.ts, nunca a mano. `create`
    // exige que el índice refleje una Asignacion real donde el profesor
    // referenciado sea efectivamente el profesorSupervisorId — evita que
    // alguien se autoconceda acceso escribiendo un índice falso.
    match /autorizaciones/{id} {
      allow read: if request.auth != null && (
        resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow create: if request.auth != null
        && (request.resource.data.profesorUid == request.auth.uid || esAccesoCompletoLiceo(request.resource.data.liceoId))
        && get(/databases/$(database)/documents/asignaciones/$(request.resource.data.asignacionId)).data.profesorSupervisorId == request.resource.data.profesorUid;
      allow update: if request.auth != null
        && (request.resource.data.profesorUid == request.auth.uid || esAccesoCompletoLiceo(request.resource.data.liceoId));
      allow delete: if request.auth != null
        && (resource.data.profesorUid == request.auth.uid || esAccesoCompletoLiceo(resource.data.liceoId));
    }

    // Conversaciones: visibles y editables únicamente por sus participantes
    // — pertenecer al mismo liceo/dominio no da acceso a chats ajenos.
    match /conversaciones/{convId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantes;
      allow delete: if false;
    }
    match /conversaciones/{convId}/{subCollection}/{docId} {
      allow read, create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes;
      allow update, delete: if false;
    }

    // Colecciones de nivel raíz sin regla dedicada (especialidades,
    // documentos_generados, etc.) — abiertas a cualquier autenticado, como
    // hasta ahora. IMPORTANTE: toda colección con un `match` propio más
    // arriba DEBE agregarse a `tieneReglaPropia()`, o este catch-all le
    // seguirá otorgando acceso sin restricción (las reglas de Firestore se
    // unen con OR entre todos los bloques que coincidan con la ruta).
    match /{collection}/{docId} {
      allow read, write: if request.auth != null && !tieneReglaPropia(collection);
    }
  }
}
