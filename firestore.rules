rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones auxiliares ──────────────────────────────────────────
    //
    // Firestore evalúa TODOS los bloques `match` cuya ruta coincida con la
    // petición, y concede acceso si CUALQUIERA de ellos lo permite (unión,
    // no "el más específico gana"). Por eso el catch-all al final de este
    // archivo debe excluir explícitamente toda colección que tenga su
    // propio bloque `match` más arriba — si no, el catch-all seguiría
    // otorgando lectura/escritura abierta a esa colección sin importar
    // cuán estricta sea su regla dedicada. Ver `tieneReglaPropia`.

    function datosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Administrador: alcance global. Director/Coordinador: su liceo
    // completo. Ver lib/permisos/ambito.ts (misma matriz, lado cliente).
    function esAccesoCompletoLiceo(liceoId) {
      return request.auth != null && (
        datosUsuario().rol == 'administrador'
        || ((datosUsuario().rol == 'director' || datosUsuario().rol == 'coordinador') && datosUsuario().liceoId == liceoId)
      );
    }

    // ¿Existe un documento de índice que autorice a este profesor sobre
    // este recurso? (colección `autorizaciones`, mantenida por
    // lib/permisos/sincronizarAutorizacion.ts a partir de las Asignaciones
    // reales — una regla no puede ejecutar una consulta, solo leer por
    // ruta conocida, por eso existe este índice).
    function tieneAutorizacion(tipo, recursoId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/autorizaciones/$(request.auth.uid + '_' + tipo + '_' + recursoId));
    }

    function tieneReglaPropia(coleccion) {
      return coleccion in [
        'usuarios', 'sesiones', 'auditoria', 'liceos', 'codigosAcceso',
        'solicitudesModificacion', 'soporte', 'contadores', 'tickets',
        'notificaciones', 'estudiantes', 'asignaciones', 'centros_duales',
        'maestros_guia', 'visitas', 'autorizaciones', 'conversaciones',
        'invitaciones', 'respuestas_invitacion', 'centros_duales_por_rut',
        'evaluaciones', 'invitaciones_estudiante', 'respuestas_invitacion_estudiante',
        'estudiantes_por_run', 'campanias_invitacion', 'campanias_invitacion_estudiante',
        'respuestas_campania', 'respuestas_campania_estudiante', 'demos',
        'planes_comerciales', 'configuracion_comercial', 'documentos_generados', 'especialidades',
        'documentos_generados_indices'
      ];
    }

    match /usuarios/{docId} {
      // Antes: cualquier autenticado podía leer la cuenta de cualquier
      // otro usuario, de cualquier liceo — un estudiante o Centro Dual
      // podía así "navegar" los datos de otro estudiante/empresa/director.
      // Ahora: su propia cuenta, acceso completo de liceo (admin/director/
      // coordinador), un profesor viendo a cualquiera de su liceo (lo
      // necesita para gestión), o cualquiera viendo la cuenta de UN
      // profesor o administrador puntual (nombre del Profesor Supervisor
      // mostrado en Visitas/Centros, o del administrador al notificar un
      // ticket — dato de personal institucional, no de otro
      // estudiante/empresa/director cuya cuenta sí debe quedar protegida).
      allow read: if request.auth != null && (
        request.auth.uid == docId
        || esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().liceoId == resource.data.liceoId && datosUsuario().rol == 'profesor')
        || resource.data.rol == 'profesor'
        || resource.data.rol == 'administrador'
      );
      // Creación: el propio usuario (alta de cuenta, incluida la firma
      // de Firebase Auth que queda momentáneamente autenticada como el
      // nuevo usuario al crearlo) o un administrador completando una
      // ficha. Sin restricción de campos: el documento no existe todavía.
      allow create: if request.auth != null
        && (request.auth.uid == docId
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador');
      // Edición: un administrador puede modificar cualquier cuenta (rol,
      // estado, especialidad, etc. — eso es Administración). El propio
      // usuario solo puede editar su perfil personal (Mi perfil) y NUNCA
      // su rol, estado de cuenta, liceo, correo, nombre o especialidad —
      // el frontend los bloquea, pero la regla es la que realmente protege.
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
        || (request.auth.uid == docId
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['rol', 'activo', 'liceoId', 'email', 'nombre', 'especialidad', 'uid']))
      );
      // Eliminación: solo vía la API de administrador (firebase-admin, con su propia
      // verificación de rol) — nunca directamente desde el cliente.
      allow delete: if false;
    }

    match /sesiones/{sesionId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Registro de auditoría: cualquiera autenticado puede crear un evento
    // (denegaciones, acciones sensibles), pero solo el administrador puede
    // leerlo. Nadie puede editar ni borrar un registro ya escrito.
    match /auditoria/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && datosUsuario().rol == 'administrador';
      allow update, delete: if false;
    }

    match /liceos/{liceoId} {
      allow read: if true;
      // Solo el administrador, o el director de ESE liceo, puede modificarlo.
      // Los campos de Demo (esDemo/demoId/demoVenceEn/demoEstado/planEstado)
      // quedan fuera del alcance del director: son de solo lectura para él
      // (los escribe el reclamo del enlace o el cron de vencimiento, ambos
      // con privilegio de servidor) — si no, cualquier director de una demo
      // podría "extender" su prueba escribiendo esos campos directamente
      // desde la consola del navegador.
      allow write: if request.auth != null
        && datosUsuario().rol in ['administrador', 'director']
        && (datosUsuario().rol == 'administrador'
            || (datosUsuario().liceoId == liceoId
                && !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['esDemo', 'demoId', 'demoVenceEn', 'demoEstado', 'planEstado'])));
    }

    // Acceso de Demostración (Configuración → Acceso de Demostración): solo
    // el administrador (rol cross-liceo de la plataforma) genera, lee y
    // cancela enlaces de demo desde el cliente. Todo lo que ocurre sin
    // sesión (validar el token público, registrar la institución que
    // reclama la demo, marcarla vencida/eliminada) pasa por rutas de API
    // con privilegio de servidor (lib/firebase-admin.ts), igual que
    // invitaciones/campanias — nunca directamente desde el cliente.
    match /demos/{demoId} {
      allow read, write: if request.auth != null && datosUsuario().rol == 'administrador';
    }

    // Sección comercial "Planes SIGEDUAL": catálogo de precios/estados,
    // público para que la página comercial (y la propia institución al
    // decidir contratar) lo vea sin sesión — pero solo administrador puede
    // modificar precios, estados o características (información comercial
    // sensible de SIGEDUAL).
    match /planes_comerciales/{planId} {
      allow read: if true;
      allow write: if request.auth != null && datosUsuario().rol == 'administrador';
    }
    match /configuracion_comercial/{docId} {
      allow read: if true;
      allow write: if request.auth != null && datosUsuario().rol == 'administrador';
    }

    match /codigosAcceso/{liceoId} {
      // Lectura pública: se necesita para validar el código al crear una
      // cuenta, momento en el que la persona todavía no tiene sesión.
      allow read: if true;
      // Solo el administrador, o el director de ESE liceo, puede generar
      // o renovar el código. Este código es para Profesor Supervisor y
      // Coordinador (staff con correo del dominio autorizado del liceo).
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['administrador', 'director']
        && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.liceoId == liceoId);
    }

    match /solicitudesModificacion/{id} {
      // Solicitudes de cambio de un dato bloqueado del propio perfil (Mi
      // perfil > Solicitar modificación). Solo su autor o un administrador
      // pueden leerlas; solo un administrador puede resolverlas (estado).
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /soporte/{liceoId} {
      allow read: if request.auth != null;
      // Solo el administrador (dueño de la plataforma) puede editar el
      // contacto de soporte, ni siquiera el director.
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /contadores/{contadorId} {
      allow read, write: if request.auth != null;
    }

    match /tickets/{ticketId} {
      // Lectura: quien lo creó, o el administrador (nunca otros usuarios).
      allow read: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow create: if request.auth != null && request.resource.data.creadoPor == request.auth.uid;
      // Cambios de estado/prioridad/asignación: solo el administrador.
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    // Hilo público del ticket: visible/editable por su creador o el administrador.
    match /tickets/{ticketId}/mensajes/{msgId} {
      allow read, create: if request.auth != null && (
        get(/databases/$(database)/documents/tickets/$(ticketId)).data.creadoPor == request.auth.uid
        || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador'
      );
      allow update, delete: if false;
    }

    // Notas internas: exclusivas del administrador, el creador del ticket nunca las ve.
    match /tickets/{ticketId}/notasInternas/{notaId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /notificaciones/{notifId} {
      // Cada notificación es visible/editable solo por su destinatario
      // (marcar como leída). Cualquier usuario autenticado puede crear una
      // notificación dirigida a otro (ej: un ticket nuevo notifica al admin).
      allow read, update, delete: if request.auth != null && resource.data.destinatarioUid == request.auth.uid;
      allow create: if request.auth != null;
    }

    // ── Autorización granular por ámbito (Formación Profesional Dual) ──
    //
    // Pertenecer al mismo liceo/dominio ya no es suficiente por sí solo.
    // administrador → global. director/coordinador → su liceo completo.
    // profesor → solo su ámbito: los estudiantes/centros/maestros guía
    // vinculados a él por una Asignacion real (ver `autorizaciones` más
    // abajo, y lib/permisos/ en el cliente).

    match /estudiantes/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol in ['profesor', 'centro_dual'] && tieneAutorizacion('estudiante', id))
        // Un estudiante ve exclusivamente su propia ficha, nunca la de otro.
        || (datosUsuario().rol == 'estudiante' && datosUsuario().estudianteId == id)
      );
      allow create: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador', 'profesor'])
      );
      allow update: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol in ['profesor', 'centro_dual'] && tieneAutorizacion('estudiante', id))
      );
      // Eliminar un estudiante es una acción administrativa, no de supervisión.
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    match /asignaciones/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || resource.data.profesorSupervisorId == request.auth.uid
        || (datosUsuario().rol == 'centro_dual' && resource.data.maestroGuiaId == datosUsuario().maestroGuiaId)
        // Cuenta Centro Dual "de empresa" (sin maestroGuiaId, creada con el
        // correo del propio Centro Dual): ve todas las asignaciones de su
        // empresa, no solo las de un Maestro Guía — a diferencia de la
        // rama de arriba, que sigue acotada a un Maestro Guía puntual.
        || (datosUsuario().rol == 'centro_dual' && !('maestroGuiaId' in datosUsuario()) && datosUsuario().centroDualId == resource.data.centroDualId)
        // Un estudiante ve exclusivamente sus propias asignaciones.
        || (datosUsuario().rol == 'estudiante' && datosUsuario().estudianteId == resource.data.estudianteId)
      );
      // Crear una asignación requiere ver y elegir entre TODOS los
      // estudiantes/centros del liceo todavía sin asignar — visión que un
      // profesor no debe tener (rompería el aislamiento por ámbito). Por
      // eso solo administrador/director/coordinador crean asignaciones; el
      // ámbito de un profesor se gana automáticamente en cuanto una de
      // ellas lo nombra profesorSupervisorId.
      allow create: if request.auth != null && esAccesoCompletoLiceo(request.resource.data.liceoId);
      // Un profesor solo puede modificar (nunca eliminar) una asignación
      // de la que ya es responsable — no puede tocar la de un colega.
      allow update: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || resource.data.profesorSupervisorId == request.auth.uid
      );
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    // Catálogo de especialidades del liceo: dato de referencia (nombres),
    // no personal — cualquier rol de ESE liceo puede leerlo (lo necesitan
    // todas las fichas/formularios), pero antes no tenía regla propia y
    // caía en el catch-all: cualquier autenticado, de CUALQUIER liceo,
    // podía leer y también escribir/borrar el catálogo de otro liceo.
    match /especialidades/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || datosUsuario().liceoId == resource.data.liceoId
      );
      allow create: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador'])
      );
      allow update, delete: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador'])
      );
    }

    match /centros_duales/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('centro', id))
        || (datosUsuario().rol == 'centro_dual' && datosUsuario().centroDualId == id)
        // Un estudiante ve solo el Centro Dual de su propia asignación.
        || (datosUsuario().rol == 'estudiante' && tieneAutorizacion('centro', id))
      );
      allow create: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador', 'profesor'])
      );
      allow update: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('centro', id))
      );
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    match /maestros_guia/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('maestro', id))
        || (datosUsuario().rol == 'centro_dual' && datosUsuario().maestroGuiaId == id)
        // Cuenta Centro Dual "de empresa": ve a todos los Maestros Guía de
        // su propia empresa, no solo a uno.
        || (datosUsuario().rol == 'centro_dual' && !('maestroGuiaId' in datosUsuario())
            && datosUsuario().centroDualId == resource.data.centroDualId)
        // Un estudiante ve solo el Maestro Guía de su propia asignación.
        || (datosUsuario().rol == 'estudiante' && tieneAutorizacion('maestro', id))
      );
      allow create: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador', 'profesor'])
      );
      allow update: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && tieneAutorizacion('maestro', id))
      );
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    // Registro digital de una visita a un Centro Dual. "update" queda
    // prohibido en cuanto estado == 'finalizada' — sin excepción, ni
    // siquiera para acceso completo de liceo: la sección de integridad
    // del pedido exige que una visita finalizada sea inmutable de verdad,
    // no solo ocultar el botón "Editar" en la interfaz. centro_dual (la
    // Empresa/Centro Dual) solo tiene lectura, nunca create/update.
    match /visitas/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && (
          resource.data.profesorSupervisorId == request.auth.uid
          || resource.data.profesorId == request.auth.uid
          || (('estudianteId' in resource.data) && tieneAutorizacion('estudiante', resource.data.estudianteId))
          // Solo cubre el primer estudiante de una visita multi-estudiante —
          // el caso común (un profesor viendo el historial de un estudiante
          // que él mismo no visitó) igual queda cubierto por profesorSupervisorId
          // arriba en la inmensa mayoría de los casos reales.
          || (('estudianteIds' in resource.data) && resource.data.estudianteIds.size() > 0
              && tieneAutorizacion('estudiante', resource.data.estudianteIds[0]))
        ))
        || (datosUsuario().rol == 'centro_dual' && datosUsuario().centroDualId == resource.data.centroDualId)
        // Un estudiante ve solo las visitas donde él es uno de los
        // estudiantes involucrados (modelo actual, plural) o, en una visita
        // antigua de una sola persona (modelo legado), donde es el único.
        || (datosUsuario().rol == 'estudiante' && (
          (('estudianteIds' in resource.data) && datosUsuario().estudianteId in resource.data.estudianteIds)
          || (('estudianteId' in resource.data) && resource.data.estudianteId == datosUsuario().estudianteId)
        ))
      );
      allow create: if request.auth != null && (
        esAccesoCompletoLiceo(request.resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == request.resource.data.liceoId)
      );
      allow update: if request.auth != null && resource.data.estado != 'finalizada' && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || resource.data.profesorSupervisorId == request.auth.uid
        || resource.data.profesorId == request.auth.uid
      );
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    // Evaluación de desempeño del estudiante en su Centro Dual. Cada
    // documento es un registro completo e inmutable (sin borrador/guardado
    // parcial): "update" deshabilitado a propósito — un error se corrige
    // creando una evaluación nueva, nunca editando la anterior.
    match /evaluaciones/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol in ['profesor', 'centro_dual'] && tieneAutorizacion('estudiante', resource.data.estudianteId))
        // Un estudiante ve solo sus propias evaluaciones, nunca las de otro.
        || (datosUsuario().rol == 'estudiante' && datosUsuario().estudianteId == resource.data.estudianteId)
      );
      allow create: if request.auth != null && (
        esAccesoCompletoLiceo(request.resource.data.liceoId)
        || (datosUsuario().rol in ['profesor', 'centro_dual'] && tieneAutorizacion('estudiante', request.resource.data.estudianteId))
      );
      allow update: if false;
      allow delete: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
    }

    // Documento/Convenio generado desde una plantilla (Documentos →
    // documentos/convenios). Antes caía en el catch-all de abajo: cualquier
    // autenticado, de cualquier liceo, podía leer y escribir cualquiera —
    // se corrige acá de paso. `centro_dual`/`estudiante` NUNCA crean, editan
    // ni eliminan un documento — solo pueden VER el que esté a su nombre
    // (por `estudianteId`); crear/editar/eliminar es exclusivo del staff
    // del liceo (profesor mantiene su alcance de liceo completo).
    match /documentos_generados/{id} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == resource.data.liceoId)
        || (datosUsuario().rol == 'centro_dual' && ('estudianteId' in resource.data) && tieneAutorizacion('estudiante', resource.data.estudianteId))
        || (datosUsuario().rol == 'estudiante' && ('estudianteId' in resource.data) && resource.data.estudianteId == datosUsuario().estudianteId)
      );
      allow create: if request.auth != null && (
        esAccesoCompletoLiceo(request.resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == request.resource.data.liceoId)
      );
      // Un documento/convenio "finalizado" (a diferencia de "borrador", que
      // sigue siendo un trabajo en curso) es inmutable — igual criterio que
      // una Evaluación o una Visita finalizada: nadie, ni siquiera acceso
      // completo de liceo, puede editarlo después de guardarlo. Para
      // corregir algo se crea uno nuevo (Duplicar), nunca se edita el original.
      allow update: if request.auth != null && resource.data.estado != 'finalizado' && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == resource.data.liceoId)
      );
      allow delete: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || resource.data.creadoPor == request.auth.uid
      );
    }

    // Índice de unicidad de nombre para documentos_generados (mismo criterio
    // que centros_duales_por_rut/estudiantes_por_run): sin datos personales,
    // solo referencia opaca (documentoId/liceoId/tipoModulo). Solo quien
    // puede crear/editar el documento real (ver regla de arriba — nunca
    // centro_dual/estudiante) mantiene su entrada en este índice.
    match /documentos_generados_indices/{clave} {
      allow read: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == resource.data.liceoId)
      );
      allow create, update: if request.auth != null && (
        esAccesoCompletoLiceo(request.resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == request.resource.data.liceoId)
      );
      allow delete: if request.auth != null && (
        esAccesoCompletoLiceo(resource.data.liceoId)
        || (datosUsuario().rol == 'profesor' && datosUsuario().liceoId == resource.data.liceoId)
      );
    }

    // Índice de autorización: un documento por (profesor, tipo, recurso)
    // que respalda `tieneAutorizacion()` arriba. Se mantiene desde
    // lib/permisos/sincronizarAutorizacion.ts, nunca a mano. `create`
    // exige que el índice refleje una Asignacion real donde el profesor
    // referenciado sea efectivamente el profesorSupervisorId — evita que
    // alguien se autoconceda acceso escribiendo un índice falso.
    match /autorizaciones/{id} {
      allow read: if request.auth != null && (
        resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow create: if request.auth != null
        && (request.resource.data.profesorUid == request.auth.uid || esAccesoCompletoLiceo(request.resource.data.liceoId))
        && (
          get(/databases/$(database)/documents/asignaciones/$(request.resource.data.asignacionId)).data.profesorSupervisorId == request.resource.data.profesorUid
          || (datosUsuario().rol == 'centro_dual' && get(/databases/$(database)/documents/asignaciones/$(request.resource.data.asignacionId)).data.maestroGuiaId == datosUsuario().maestroGuiaId)
          // Cuenta Centro Dual "de empresa" (ver asignaciones): mismo
          // índice, pero para toda la empresa en vez de un Maestro Guía.
          || (datosUsuario().rol == 'centro_dual' && !('maestroGuiaId' in datosUsuario())
              && get(/databases/$(database)/documents/asignaciones/$(request.resource.data.asignacionId)).data.centroDualId == datosUsuario().centroDualId)
          // Un estudiante autoriza su propio acceso a su Centro Dual/Maestro
          // Guía (índices 'centro'/'maestro') a partir de su propia Asignacion.
          || (datosUsuario().rol == 'estudiante'
              && get(/databases/$(database)/documents/asignaciones/$(request.resource.data.asignacionId)).data.estudianteId == datosUsuario().estudianteId)
        );
      allow update: if request.auth != null
        && (request.resource.data.profesorUid == request.auth.uid || esAccesoCompletoLiceo(request.resource.data.liceoId));
      allow delete: if request.auth != null
        && (resource.data.profesorUid == request.auth.uid || esAccesoCompletoLiceo(resource.data.liceoId));
    }

    // Invitación a Empresa Dual: el profesor que la genera (o
    // administrador/coordinador/director de su liceo) puede crearla,
    // leerla y actualizarla (revocar). La empresa invitada NUNCA tiene
    // sesión de Firebase Auth — su acceso pasa exclusivamente por las
    // rutas de API en app/api/invitaciones/ (privilegio de servidor),
    // nunca por estas reglas de cliente.
    match /invitaciones/{id} {
      allow read, update: if request.auth != null && (
        resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow create: if request.auth != null && (
        request.resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(request.resource.data.liceoId)
      );
      allow delete: if false;
    }

    // Respuesta que la empresa envió: la escribe únicamente la ruta de API
    // (la empresa no tiene sesión). El profesor dueño de la invitación (o
    // acceso completo de liceo) puede leerla para revisar el formulario,
    // pero no puede editar la respuesta cruda de la empresa desde el
    // cliente — solo lo que resulte del autorrellenado, que también pasa
    // por la ruta de API.
    match /respuestas_invitacion/{id} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/invitaciones/$(id)).data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow write: if false;
    }

    // Índice inverso RUT → CentroDual (los documentos de centros_duales
    // usan ID autogenerado). Igual patrón que `autorizaciones`: solo
    // lectura por quien tiene acceso completo al liceo dueño; la
    // escritura la hace el mismo código que crea/edita el centro.
    match /centros_duales_por_rut/{rutNormalizado} {
      allow read: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
      // Mismo criterio que la creación/edición de un centro dual: quien
      // puede escribir el centro puede mantener su entrada en el índice.
      allow write: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador', 'profesor'])
      );
    }

    // Invitación a Estudiante: mismo patrón que la invitación a Empresa
    // Dual de arriba, pero en colecciones separadas — el estudiante
    // invitado tampoco tiene sesión de Firebase Auth, así que su envío
    // pasa exclusivamente por app/api/invitaciones-estudiante/.
    match /invitaciones_estudiante/{id} {
      allow read, update: if request.auth != null && (
        resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow create: if request.auth != null && (
        request.resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(request.resource.data.liceoId)
      );
      allow delete: if false;
    }

    match /respuestas_invitacion_estudiante/{id} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/invitaciones_estudiante/$(id)).data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow write: if false;
    }

    // Índice inverso RUN → Estudiante, mismo patrón que
    // centros_duales_por_rut.
    match /estudiantes_por_run/{runNormalizado} {
      allow read: if request.auth != null && esAccesoCompletoLiceo(resource.data.liceoId);
      allow write: if request.auth != null && (
        datosUsuario().rol == 'administrador'
        || (datosUsuario().liceoId == request.resource.data.liceoId && datosUsuario().rol in ['director', 'coordinador', 'profesor'])
      );
    }

    // Formulario masivo (campaña): mismo criterio de acceso que una
    // invitación individual — la campaña la crea/lee/actualiza (revocar,
    // cambiar capacidad) el profesor que la generó o acceso completo de
    // liceo. El incremento de `respuestasCount` en cada envío externo lo
    // hace únicamente la ruta de API (commit atómico con precondición),
    // nunca el cliente, por eso "update" también exige la misma condición
    // de dueño/liceo — evita que cualquier usuario autenticado manipule el
    // cupo de una campaña ajena.
    match /campanias_invitacion/{id} {
      allow read, update: if request.auth != null && (
        resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow create: if request.auth != null && (
        request.resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(request.resource.data.liceoId)
      );
      allow delete: if false;
    }

    match /campanias_invitacion_estudiante/{id} {
      allow read, update: if request.auth != null && (
        resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow create: if request.auth != null && (
        request.resource.data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(request.resource.data.liceoId)
      );
      allow delete: if false;
    }

    // Respuestas de una campaña: a diferencia de respuestas_invitacion, el
    // id de la respuesta NO coincide con el de la campaña (una campaña
    // tiene muchas respuestas), así que la regla resuelve el dueño vía
    // `campaniaId`. Toda escritura (envío externo, cambios de estado,
    // traspaso) pasa por rutas de API con privilegio de servidor.
    match /respuestas_campania/{id} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/campanias_invitacion/$(resource.data.campaniaId)).data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow write: if false;
    }

    match /respuestas_campania_estudiante/{id} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/campanias_invitacion_estudiante/$(resource.data.campaniaId)).data.profesorUid == request.auth.uid
        || esAccesoCompletoLiceo(resource.data.liceoId)
      );
      allow write: if false;
    }

    // Conversaciones: visibles y editables únicamente por sus participantes
    // — pertenecer al mismo liceo/dominio no da acceso a chats ajenos.
    match /conversaciones/{convId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantes;
      allow delete: if false;
    }
    match /conversaciones/{convId}/{subCollection}/{docId} {
      allow read, create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes;
      allow update, delete: if false;
    }

    // Colecciones de nivel raíz sin regla dedicada (especialidades,
    // documentos_generados, etc.) — abiertas a cualquier autenticado, como
    // hasta ahora. IMPORTANTE: toda colección con un `match` propio más
    // arriba DEBE agregarse a `tieneReglaPropia()`, o este catch-all le
    // seguirá otorgando acceso sin restricción (las reglas de Firestore se
    // unen con OR entre todos los bloques que coincidan con la ruta).
    match /{collection}/{docId} {
      allow read, write: if request.auth != null && !tieneReglaPropia(collection);
    }
  }
}
