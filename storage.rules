rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: cada usuario solo puede subir/leer/borrar las suyas
    match /perfiles/{uid}/{allPaths=**} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Evidencias de práctica
    match /evidencias/{liceoId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Archivos adjuntos de conversaciones
    match /conversaciones/{convId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Documentos del sistema
    match /documentos/{liceoId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
